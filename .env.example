# 本机 PostgreSQL 连接。请替换用户名和密码；密码中的 @、:、/ 等字符需要 URL 编码。
DATABASE_URL=postgresql+psycopg://fashion_explorer:CHANGE_ME@localhost:5432/fashion_explorer
NEXT_PUBLIC_API_URL=http://localhost:8000
ENVIRONMENT=development
RECOMMENDATION_ALGORITHM=rule_v1
DEFAULT_EXPLORATION_LEVEL=50
TAOBAO_API_KEY=
JD_API_KEY=
# Required only when JD_ENABLED=true.  Obtain the endpoint and parameter names
# from the JD API product you subscribed to; never put these values in frontend code.
JD_ENABLED=false
JD_API_URL=
JD_API_KEY_PARAM=api_key
JD_QUERY_PARAM=q
JD_SEARCH_RATIO_PERCENT=10
JD_MAX_PRODUCTS_PER_SEARCH=2
JD_MIN_REQUEST_INTERVAL_SECONDS=60
PDD_API_KEY=
AUTH_SECRET_KEY=replace-with-a-long-random-secret
AUTH_ACCESS_TOKEN_MINUTES=480
# Set both values in Render before registering the first administrator account.
BOOTSTRAP_ADMIN_EMAIL=your-admin@example.com
BOOTSTRAP_ADMIN_CODE=choose-a-one-time-admin-code
